# ── SmartHire · .env.example ──
# Copy to .env and fill in all REQUIRED values.
# NEVER commit .env to version control.

# ── Database (REQUIRED) ────────────────────────────────────────────────────────
DB_USER=smarthire
DB_PASS=CHANGE_ME_strong_db_password_here

# ── Redis (REQUIRED) ───────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_here

# ── JWT (REQUIRED) ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64_minimum_32_chars


# ── MinIO file storage (REQUIRED for resume uploads) ──────────────────────────
# MinIO runs as a local service via Docker Compose.
# For production: use MinIO Cloud, AWS S3, or GCS (just change MINIO_ENDPOINT).
MINIO_ACCESS_KEY=smarthire
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_secret_min_8_chars
MINIO_BUCKET=smarthire-resumes
# For local Docker: http://localhost:9000
# For production S3: https://s3.amazonaws.com
MINIO_ENDPOINT=http://localhost:9000

# ── Claude AI (optional — TF-IDF fallback used if empty) ──────────────────────
CLAUDE_API_KEY=
# Set to false to disable Claude entirely and use only TF-IDF scoring
CLAUDE_ENABLED=true

# ── Email (optional — status notifications disabled if empty) ──────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost

# ── Spring profile ─────────────────────────────────────────────────────────────
# Use "prod" for production (enables HSTS, hides Swagger, JSON logging)
SPRING_PROFILES_ACTIVE=default

# ── Monitoring ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_grafana_admin_password

# ── CI/CD (GitHub Actions secrets — not used locally) ─────────────────────────
# DOCKER_USERNAME        — Docker Hub username
# DOCKER_PASSWORD        — Docker Hub access token
# DEPLOY_HOOK_URL        — Render or Railway deploy hook URL
# SLACK_WEBHOOK          — Slack incoming webhook URL for deploy notifications
