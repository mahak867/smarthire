{
  "info": {
    "name": "SmartHire API",
    "_postman_id": "smarthire-v1",
    "description": "SmartHire — AI-powered recruitment platform API. Import this collection, set the `baseUrl` variable, and use the Login request to auto-populate the Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8080/api/v1" },
    { "key": "accessToken",  "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"candidate@test.com\",\"password\":\"Password1\",\"firstName\":\"Jane\",\"lastName\":\"Doe\"}"
            }
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.accessToken) {",
                "  pm.collectionVariables.set('accessToken', r.accessToken);",
                "  pm.collectionVariables.set('refreshToken', r.refreshToken);",
                "  pm.test('Login successful', () => pm.response.to.have.status(200));",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"candidate@test.com\",\"password\":\"Password1\"}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Refresh Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.accessToken) {",
                "  pm.collectionVariables.set('accessToken', r.accessToken);",
                "  pm.collectionVariables.set('refreshToken', r.refreshToken);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/auth/logout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List Jobs (public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/jobs?status=OPEN&page=0&size=20", "query": [
              { "key": "status", "value": "OPEN" },
              { "key": "page",   "value": "0" },
              { "key": "size",   "value": "20" }
            ]}
          }
        },
        {
          "name": "Create Job (Recruiter)",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/jobs",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Senior Java Developer\",\"description\":\"We are looking for an experienced Java developer to join our team.\",\"requirements\":\"Java 17+, Spring Boot, PostgreSQL, 3+ years experience\",\"department\":\"Engineering\",\"location\":\"Bengaluru, India\",\"employmentType\":\"FULL_TIME\",\"salaryMin\":1500000,\"salaryMax\":2500000,\"deadline\":\"2026-09-01\"}"
            }
          }
        },
        {
          "name": "Get Job by ID",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/jobs/{{jobId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Submit Application (Candidate)",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/applications",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"jobId\":\"{{jobId}}\",\"resumeUrl\":\"https://example.com/resume.pdf\",\"coverLetter\":\"I am excited to apply for this position...\"}"
            }
          }
        },
        {
          "name": "List Applications (Recruiter)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/applications?page=0&size=20", "query": [
              { "key": "page", "value": "0" }, { "key": "size", "value": "20" }
            ]},
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Application by ID",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/applications/{{applicationId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Update Application Status (Recruiter)",
          "request": {
            "method": "PUT", "url": "{{baseUrl}}/applications/{{applicationId}}/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\":\"SHORTLISTED\",\"notes\":\"Strong technical background, good cultural fit\"}" }
          }
        },
        {
          "name": "My Applications (Candidate)",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/applications/my",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Ranked Applications for Job (Recruiter)",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/applications/job/{{jobId}}/ranked",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Stats",
          "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] }
        },
        {
          "name": "Pipeline Breakdown",
          "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/pipeline",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] }
        },
        {
          "name": "Top Candidates",
          "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/top-candidates",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] }
        },
        {
          "name": "Hiring Funnel",
          "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/hiring-funnel",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }] }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        { "name": "Liveness",  "request": { "method": "GET", "url": "{{baseUrl}}/../actuator/health" } },
        { "name": "Prometheus","request": { "method": "GET", "url": "{{baseUrl}}/../actuator/prometheus" } }
      ]
    }
  ]
}
